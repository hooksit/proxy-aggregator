# ==============================================================================
# VPN Vault Panel Configuration Environment File
# Copy this file to .env and change the credentials!
# ==============================================================================

# Server settings
HOST=0.0.0.0
PORT=8080
TZ=Europe/Moscow

# Security & Admin Access (Optional)
# If left empty, you will be prompted to create your admin login and password in the browser upon opening the website.
SECRET_KEY=super-secret-key-change-me-in-production
DEFAULT_USERNAME=
DEFAULT_PASSWORD=

# Scheduler Defaults
DEFAULT_PARSE_INTERVAL_HOURS=12
DEFAULT_CHECK_INTERVAL_MINUTES=5
DEFAULT_SPEEDTEST_ENABLED=false
